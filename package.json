{
  "name": "dsh-bili-qq",
  "version": "2.0.0",
  "description": "DSH 离线推荐流选择审计插件：从本地视频库与固定轨迹回放 B站推荐卡片和观看内容，只暴露选择视频所需工具，不访问 B站、不收藏、不评论、不投递。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "examples",
    "locale",
    "icon.svg",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "bilibili",
    "recommendation-audit",
    "agent-audit",
    "offline-replay"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mswinandmc/dsh-bili-qq.git"
  },
  "homepage": "https://github.com/mswinandmc/dsh-bili-qq#readme",
  "bugs": {
    "url": "https://github.com/mswinandmc/dsh-bili-qq/issues"
  },
  "author": "mswinandmc",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-manifest.mjs && npm test",
    "pack:check": "npm pack --dry-run"
  }
}
